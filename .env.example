# 핵심 키 (없으면 해당 provider는 결정론적 mock으로 동작)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

# LLM을 로컬 Claude CLI(`claude -p`)로 — API 키 없이 기존 Claude 로그인 사용
# (브리프/스펙/콘티/컨셉 생성). 1=켜기. 실패 시 mock 폴백.
CLAUDE_CLI=0

# 무료 AI 이미지 생성 (Pollinations.ai / Flux) — API 키 없이 실제 이미지. 테스트/데모용.
# 1=켜기 (유료 키가 있으면 그게 우선, 없으면 무료 Pollinations로 실 이미지 → mock 폴백).
FREE_IMAGES=0
# FREE_IMAGE_MODEL=flux
# FREE_IMAGE_TIMEOUT=90
# CLAUDE_CLI_MODEL=claude-haiku-4-5-20251001   # 빠른/저렴 모델 (비우면 CLI 기본)
# CLAUDE_CLI_TIMEOUT=120                        # CLI 호출 타임아웃(초)

# 선택
REPLICATE_API_TOKEN=
MODELARK_API_KEY=

# RunPod에 띄운 Qwen 이미지 모델 (설정 시 이미지 생성 1순위 → Nano Banana/Flux fallback)
RUNPOD_API_KEY=
RUNPOD_QWEN_ENDPOINT=   # serverless 엔드포인트 ID, 또는 커스텀 pod 전체 URL
# 워커 input 추가/오버라이드 (JSON) — 워커 계약에 맞춰 파라미터 조정 (코드 변경 없이)
RUNPOD_QWEN_INPUT=     # 예: {"negative_prompt":"blurry, lowres","num_inference_steps":30,"guidance_scale":4}
# 오픈소스 image-to-video 워커 (Wan 2.2 / LTX-Video / SVD) — 무료/오픈 영상 경로. 없으면 ffmpeg Ken Burns.
RUNPOD_VIDEO_ENDPOINT= # serverless 엔드포인트 ID, 또는 커스텀 pod 전체 URL
RUNPOD_VIDEO_INPUT=    # 예: {"num_frames":81,"fps":16,"guidance_scale":5,"negative_prompt":"blurry"}

# 모델 ID (호출 직전 공식 문서로 확인하고 갱신)
ANTHROPIC_MODEL=claude-opus-4-8
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 강제 mock 모드 (키가 있어도 mock 사용)
CUE_FORCE_MOCK=0

# 한글/CJK 폰트 경로 override (컨테이너/Linux). 비우면 macOS→Noto CJK 자동 탐색
CUE_FONT=

# 로그 레벨 (DEBUG/INFO/WARNING/ERROR)
CUE_LOG_LEVEL=INFO

# LoRA: trigger word / style appended to every Qwen prompt (activates your trained look)
RUNPOD_QWEN_STYLE=
